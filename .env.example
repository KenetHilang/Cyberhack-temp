# Database — local SQLite by default. For production, use a PostgreSQL URL
# and set datasource provider = "postgresql" in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# HMAC secret for signing session cookies. Set a long random value in production.
SESSION_SECRET="change-me-to-a-long-random-string"

# Optional: enables the LLM-vision description layer in AI QC.
# Leave unset and the on-device computer-vision engine is used alone.
# ANTHROPIC_API_KEY="sk-ant-..."
